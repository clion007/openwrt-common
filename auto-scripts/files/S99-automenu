#!/bin/sh /etc/rc.common

START=99
STOP=

start() {
    (
        export TERM=linux
        while ! ip addr show br-lan 2>/dev/null | grep -q "inet "; do
            sleep 1
        done
        sleep 2
        clear
        echo ""
        echo "  System ready, launching setup menu..."
        echo ""
        sleep 1
        /usr/bin/openwrt
    ) < /dev/console > /dev/console 2>&1 &
}
